{
  "name": "ownership-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "osmtogeojson": {
      "@xmldom/xmldom": "0.9.12"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "dev": "tsx apps/server/src/main.ts",
    "data:backup": "tsx apps/server/src/backup-cli.ts backup",
    "data:verify": "tsx apps/server/src/backup-cli.ts verify",
    "data:restore": "tsx apps/server/src/backup-cli.ts restore",
    "data:recover": "tsx apps/server/src/backup-cli.ts recover",
    "release:stage": "tsx apps/server/src/release-cli.ts stage",
    "release:activate": "tsx apps/server/src/release-cli.ts activate",
    "release:rollback": "tsx apps/server/src/release-cli.ts rollback",
    "release:status": "tsx apps/server/src/release-cli.ts status",
    "provider:check": "tsx apps/server/src/provider-cli.ts check",
    "provider:stage": "tsx apps/server/src/provider-cli.ts stage",
    "provider:verify": "tsx apps/server/src/provider-cli.ts verify",
    "build": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build:release": "pwsh -File scripts/Build-Release.ps1",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "csv-parse": "^7.0.2",
    "fastify": "5.12.3",
    "fflate": "0.8.3",
    "geotiff": "3.0.5",
    "image-dimensions": "^2.5.1",
    "lucide-react": "1.41.0",
    "maplibre-gl": "6.7.0",
    "osmtogeojson": "3.0.0-beta.5",
    "pdfjs-dist": "^6.3.289",
    "proj4": "2.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "6.0.0",
    "tesseract.js": "^7.0.0",
    "wkx": "^0.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.4.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "pngjs": "7.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
